# Server
NODE_ENV=development
PORT=5173
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL (Supabase / Neon / Local PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/funniest_outdoor
DATABASE_SSL=false

# Auth (Ganti dengan string acak minimal 32 karakter di produksi)
JWT_SECRET=funniest-outdoor-dev-secret-change-in-production-32chars
SESSION_COOKIE_NAME=fo_session
SESSION_TTL_DAYS=7

# Default Seed Accounts (hanya dipakai saat npm run db:seed)
SEED_ADMIN_EMAIL=admin@funniestoutdoor.id
SEED_ADMIN_PASSWORD=AdminFunniest2026!
SEED_CASHIER_EMAIL=kasir@funniestoutdoor.id
SEED_CASHIER_PASSWORD=KasirFunniest2026!

# FastAPI AI Microservice (Opsional - otomatis fallback ke PostgreSQL jika kosong/timeout)
AI_SERVICE_URL=
AI_TIMEOUT_MS=1000
